# =============================================================================
#  UNIFIED PLATFORM — 統一環境變數範本
#  複製此檔為 .env 並填入真實值
#  ⚠️ .env 絕不入版控
# =============================================================================

APP_ENV=production
ADMIN_TOKEN=
JWT_SECRET=
WEBHOOK_TOKEN=
CRON_SECRET=

# ── Gate.io ──────────────────────────────────────────────────────────────────
GATE_BASE_URL=https://api.gateapi.io/api/v4
GATE_KEY=
GATE_SECRET=
GATE_FUTURES_SETTLE=usdt

# ── Telegram Bot Token（通知 + 遙控）─────────────────────────────────────────
TG_NOTIFY_TOKEN=
TG_NOTIFY_CHAT_ID=
TG_BOT_TOKEN=
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=tg_signal_session
TG_CHAT_IDS=
TG_TOKEN=
CHAT_ID=
TG_THREAD_IDS=

TG_THREAD_POSITION_CHANGE=250
TG_THREAD_CRIT_RADAR=11040
TG_THREAD_LIQUIDITY_RADAR=3
TG_THREAD_HYPERLIQUID=252
TG_THREAD_GOLD_SIGNAL=254
TG_THREAD_SECTOR_RANKING=5
TG_THREAD_WHALE_POSITION=246
TG_THREAD_SCREENER_BOARD=256
TG_THREAD_ECONOMIC_DATA=13
TG_THREAD_NEWS=7
TG_THREAD_FUNDING_RATE=244
TG_THREAD_LONG_TERM_INDEX=248
TG_THREAD_ALTSEASON_RADAR=11044

# ── Discord ──────────────────────────────────────────────────────────────────
DC_TOKEN=
DC_CHANNEL_ID=
DC_BROADCAST_WEBHOOK_URL=
DC_THREAD_IDS=

# ── TG Forwarder Controller Bot ───────────────────────────────────────────────
TG_CONTROLLER_TOKEN=
TG_CONTROLLER_ADMIN_IDS=

# ── 資料庫 / 快取 ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://platform:platform_pass@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=platform_pass

# ── 外部 API ──────────────────────────────────────────────────────────────────
CG_API_KEY=
CG_GECKO_API_KEY=
ETHERSCAN_API_KEY=
TREE_API_KEY=

# ── JackBot ───────────────────────────────────────────────────────────────────
GIST_ID=
GITHUB_TOKEN=
CRIT_RADAR_POOL=20
CRIT_RADAR_MIN_SCORE=65
CRIT_RADAR_MAX_ALERTS=3
CRIT_RADAR_COOLDOWN_HOURS=4
SNIPER_MAX_SIGNALS=3
GATE_QUANT_WEBHOOK_URL=http://gate-quant:8001/webhook/tg-signal
GOLD_ORB_MINUTES=60
GOLD_ATR_PERIOD=14
GOLD_TP_R=2.0
WHALE_SPOT_MIN_USD=500000
WHALE_LOOKBACK_SECONDS=300
WHALE_HL_MIN_DELTA_USD=100000
WHALE_EVENT_COOLDOWN_SECONDS=600
WHALE_MAX_MESSAGES_PER_RUN=5
LIQ_CHART_LOOKBACK_DAYS=10
LIQ_CHART_MAX_SYNC_DAYS=180

# ── gate-quant 參數 ───────────────────────────────────────────────────────────
MAX_RISK_USDT=50
DEFAULT_LEVERAGE=10
TG_DRY_RUN=false

# ── 刷量 Runner（Maker 往返，一週 Testnet 驗證後開帶單）────────────────────
# 第 1 週：ENABLED=1, DRY_RUN=1, GATE_BASE_URL=testnet
# 第 2 週：DRY_RUN=0 小資金實測 → ALLOW_MAINNET=1 開帶單
VOLUME_RUNNER_ENABLED=0
VOLUME_RUNNER_DRY_RUN=1
VOLUME_RUNNER_ALLOW_MAINNET=0
VOLUME_RUNNER_STRATEGY=mm
VOLUME_RUNNER_SYMBOLS=BTC_USDT,ETH_USDT
VOLUME_RUNNER_MARGIN_USDT=100
VOLUME_RUNNER_LEVERAGE=10
VOLUME_RUNNER_SPREAD_BPS=0.35
VOLUME_RUNNER_MAKER_FEE=0.00005
VOLUME_RUNNER_REBATE_PCT=0.70
VOLUME_RUNNER_TICK_INTERVAL_S=45
VOLUME_RUNNER_ACCOUNT_SLOT=1
VOLUME_RUNNER_STATE_DIR=/app/data/volume_runner

# ── 小金庫機器人（jin-ku-bot，個人 DCA 陪伴）─────────────────────────────────
# BotFather 取得；建議用 /revoke 重產一組（舊的曾外流）
JINKU_BOT_TOKEN=
# 每天幾點掃新聞（24h，逗號分隔）
JINKU_NEWS_SCAN_HOURS=9,21
# 新聞回看視窗（小時）
JINKU_NEWS_LOOKBACK_HOURS=30
